<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="suomenvaylat.dll"
        defaultNamespace="suomenvaylat"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

	<AddInInfo id="{2aea3c93-c012-4ed4-b416-6b3a844e0204}"
			   version="1.0.9"
			   desktopVersion="3.5.0.57366"
			   product="ArcGISPro">
		<Name>suomenvaylat</Name>
		<Description>Suomenväylät.fi -käynnistin (WFS Lataustyökalu)</Description>
		<Image>Images\Suomenvaylat32.png</Image>
		<Author>RPAL</Author>
		<Company>Ramboll</Company>
		<Date>2026-09-02</Date>
		<Subject>Framework</Subject>
	</AddInInfo>

	<modules>
		<insertModule id="suomenvaylat_Module"
					  className="Module1"
					  autoLoad="true"
					  caption="suomenvaylat">

			<!-- Ryhmä välilehdelle -->
			<groups>
				<group id="suomenvaylat_CustomToolsGroup"
					   caption=""
					   appearsOnAddInTab="true"
					   keytip="TL"
					   smallImage="Images\Suomenvaylat16.png"
					   largeImage="Images\Suomenvaylat32.png">
					<button refID="suomenvaylat_SuomenvaylatButton" size="large" />
				</group>
			</groups>

			<!-- Nappi -->
			<controls>
				<button id="suomenvaylat_SuomenvaylatButton"
						caption="Suomenväylät.fi"
						className="OpenSuomenvaylatToolButton"
						loadOnClick="true"
						keytip="SV"
						smallImage="Images\Suomenvaylat16.png"
						largeImage="Images\Suomenvaylat32.png">
					<tooltip heading="Suomenväylät.fi">
						Avaa lataustyökalun geoprocessing-paneeliin.
						<disabledText />
					</tooltip>
				</button>
			</controls>

		</insertModule>
	</modules>
</ArcGIS>