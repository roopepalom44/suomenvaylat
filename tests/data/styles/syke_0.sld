<?xml version='1.0' encoding='utf-8'?>
<sld:StyledLayerDescriptor xmlns:sld="http://www.opengis.net/sld" version="1.0.0"><sld:NamedLayer><sld:Name>PS.ProtectedSitesAsetusValtionOmistamienRakennustenSuojelusta</sld:Name><sld:UserStyle>
            <sld:Name>PS.ProtectedSitePoint.Default</sld:Name>
            <sld:Title>Protected Sites Point Default Style</sld:Title>
            <sld:IsDefault>1</sld:IsDefault>
            <sld:FeatureTypeStyle>
                <sld:Name>name</sld:Name>
                <sld:Rule>
                    <sld:Name>Single symbol</sld:Name>
                    <sld:PointSymbolizer>
                        <sld:Graphic>
                            <sld:Mark>
                                <sld:WellKnownName>diamond</sld:WellKnownName>
                                <sld:Fill />
                                <sld:Stroke>
                                    <sld:CssParameter name="stroke">#808080</sld:CssParameter>
                                </sld:Stroke>
                            </sld:Mark>
                            <sld:Size>6</sld:Size>
                            <sld:Rotation>45.0</sld:Rotation>
                        </sld:Graphic>
                    </sld:PointSymbolizer>
                </sld:Rule>
            </sld:FeatureTypeStyle>
        </sld:UserStyle>
    </sld:NamedLayer></sld:StyledLayerDescriptor>